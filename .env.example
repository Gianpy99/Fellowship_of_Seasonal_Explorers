# Copy to .env for local development (never commit .env).
# In production these come from the Jenkinsfile; the AI key from the Jenkins
# credential "seasonal-quest-<provider>-api-key" (provider = DEFAULT_AI_PROVIDER in the Jenkinsfile).

# development | production (production requires the Remote-User header from Caddy)
APP_ENV=development
PORT=8080
# Where explorers, generated images and quizzes are stored (a Docker volume in production)
DATA_DIR=./.data
# Pretend to be this portal user locally (ignored in production)
DEV_USER=dev

# AI provider: gemini | openai. Leave empty to use whichever key is set (Gemini first).
# With no key at all the app runs without AI features.
AI_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Used only by "npm run clean-content"
GEMINI_CONTENT_MODEL=gemini-3.8-flash

# OpenAI (https://platform.openai.com/api-keys). Image models may need organization verification.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high (cost and speed vs detail)
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-6-luna
# Used only by "npm run clean-content"
OPENAI_CONTENT_MODEL=gpt-6.1-sol

# Daily AI budget per portal user (protects the API bill)
AI_IMAGES_PER_DAY=40
AI_TEXT_PER_DAY=300
