# Copy to .env for local development (never commit .env).
# In production these come from the Jenkinsfile; the Gemini key from the
# Jenkins credential "seasonal-quest-gemini-api-key".

# development | production (production requires the Remote-User header from Caddy)
APP_ENV=development
PORT=8080
# Where explorers, generated images and quizzes are stored (a Docker volume in production)
DATA_DIR=./.data
# Pretend to be this portal user locally (ignored in production)
DEV_USER=dev

# Google Gemini (https://aistudio.google.com/apikey). Leave empty to run without AI features.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Used only by "npm run clean-content"
GEMINI_CONTENT_MODEL=gemini-3.8-flash

# Daily AI budget per portal user (protects the API bill)
AI_IMAGES_PER_DAY=40
AI_TEXT_PER_DAY=300
